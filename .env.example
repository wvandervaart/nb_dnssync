# Copy to .env and fill in real values. Never commit the real .env file.

# NetBox API token (needs read access to dcim.device and ipam.ipaddress)
NETBOX_TOKEN=

# Shared secret configured on the NetBox webhook(s); used to verify the
# X-Hook-Signature header on incoming requests.
NETBOX_WEBHOOK_SECRET=

# Base64-encoded TSIG key secret matching the key configured on the BIND
# server (same name/algorithm as dns.tsig.key_name / dns.tsig.algorithm in
# config.yaml).
TSIG_SECRET=

# Path to the YAML config file inside the container.
CONFIG_PATH=/app/config.yaml
